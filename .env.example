# Copie para .env e preencha. NUNCA commite o .env.
# As variaveis abaixo sao usadas por docker-compose.prod.yml.

# --- Banco / mensageria / auth ---
POSTGRES_PASSWORD=troque-esta-senha
RABBITMQ_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-base64-de-32-bytes

# --- Grafana ---
GRAFANA_PASSWORD=troque-esta-senha

# --- S3 (AWS real) ---
AWS_S3_BUCKET=payment-receipts
AWS_S3_REGION=us-east-1
# false = virtual-host style (recomendado na AWS). true = path-style (LocalStack/MinIO).
AWS_S3_PATH_STYLE=false
# Deixe vazio para usar a AWS. Preencha apenas para S3 compativel (MinIO etc.).
AWS_S3_ENDPOINT_URL=
# Deixe comentado para usar IAM Role/Instance Profile.
# Descomente e preencha apenas se for usar chaves estaticas.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Gateway / frontend / TLS ---
# Dominio publico atendido pelo Caddy (ex.: app.seudominio.com). Obrigatorio.
DOMAIN=app.seudominio.com
# Email para o Let's Encrypt (avisos de expiracao). Opcional.
ACME_EMAIL=ops@seudominio.com
# Origens permitidas no CORS, separadas por virgula. Use https://<DOMAIN>.
CORS_ALLOWED_ORIGINS=https://app.seudominio.com

# --- Webhook ---
# URL usada quando o merchant nao cadastrou webhook propria. Vazio = nao envia.
WEBHOOK_DEFAULT_URL=

# --- Backup ---
# Diretorio no host onde os dumps do PostgreSQL serao gravados.
BACKUP_DIR=/var/backups/payment-gateway
# Dias de retencao dos dumps locais.
BACKUP_RETENTION_DAYS=7
